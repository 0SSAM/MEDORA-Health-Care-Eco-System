# electron-builder's node-module collector resolves the pnpm binary from
# node_modules/.pnpm (pinned by the devDependency), which can differ from the
# version in package.json "packageManager". Under corepack that mismatch is a
# hard error (ERR_PNPM_BAD_PM_VERSION) and breaks Windows packaging; ignore it
# so any pnpm invocation works inside this project.
pmOnFail=ignore
