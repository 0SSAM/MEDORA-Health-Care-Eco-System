# MEDORA — environment example (complete)
# انسخ هذا الملف إلى .env ثم عدّل القيم

# === قاعدة البيانات (إلزامي) ===
DATABASE_URL=mysql://medora:medora@127.0.0.1:3306/medora
# TEST_DATABASE_URL=mysql://medora:medora@127.0.0.1:3306/medora_test
# TEST_DATABASE_ISOLATED=false

# === الخادم ===
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-generate-a-long-random-string

# === التقارير المجدولة (اختياري) ===
# REPORT_SCHEDULING_ENABLED=false
# REPORT_FROM_EMAIL=

# === OAuth خارجي / مالك النظام (اختياري) ===
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=

# === البريد (اختياري — Resend) ===
# RESEND_API_KEY=

# === التخزين والنسخ الاحتياطي المشفّر (اختياري — Forge/S3) ===
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# AUDIT_SIGNING_KEY=change-me-64-random-hex-chars

# === الواجهة (Vite — import.meta.env) ===
VITE_APP_TITLE=MEDORA
# VITE_APP_ID=
# VITE_APP_LOGO=
# VITE_ANALYTICS_ENDPOINT=
# VITE_ALDO_SALES_CONTACT_URL=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
# VITE_OAUTH_PORTAL_URL=

# === الاختبارات الشاملة (اختياري — Playwright) ===
# MEDORA_TEST_BASE_URL=http://localhost:3000
