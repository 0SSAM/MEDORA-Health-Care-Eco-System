# MEDORA — environment example (complete)
# انسخ هذا الملف إلى .env ثم عدّل القيم

# === قاعدة البيانات (إلزامي) ===
DATABASE_URL=mysql://medora:medora@127.0.0.1:3306/medora
# TEST_DATABASE_URL=mysql://medora:medora@127.0.0.1:3306/medora_test
# TEST_DATABASE_ISOLATED=false

PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-generate-a-long-random-string

# REPORT_SCHEDULING_ENABLED=false
# REPORT_FROM_EMAIL=

# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=

# RESEND_API_KEY=

# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# AUDIT_SIGNING_KEY=change-me-64-random-hex-chars

VITE_APP_TITLE=MEDORA
# VITE_APP_ID=
# VITE_APP_LOGO=
# VITE_ANALYTICS_ENDPOINT=
# VITE_ALDO_SALES_CONTACT_URL=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
# VITE_OAUTH_PORTAL_URL=

# MEDORA_TEST_BASE_URL=http://localhost:3000

# ICD11_SOURCE=clinicaltables        # افتراضي: NLM clinicaltables (مجاني، إنجليزية) — node scripts/icd11-import-nlm.mjs
# ICD11_BASE_URL=https://id.who.int/icd   # للحاوية المحلية: http://localhost:8080/icd (بدون OAuth)
# ICD_API_CLIENT_ID=                  # مطلوب فقط لسحابة WHO الرسمية (free: icd.who.int/icdapi)
# ICD_API_CLIENT_SECRET=

# ---- Communication channels (WhatsApp Cloud API + Twilio Programmable Voice) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=http://localhost:3000
MEDORA_DEFAULT_ORG_ID=1
