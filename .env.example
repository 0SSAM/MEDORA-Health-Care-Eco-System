# MEDORA — environment example
# انسخ هذا الملف إلى .env ثم عدّل القيم

# === قاعدة البيانات (إلزامي) ===
DATABASE_URL=mysql://medora:medora@127.0.0.1:3306/medora

# === الخادم ===
PORT=3000
NODE_ENV=development

# === الواجهة (Vite) ===
VITE_APP_TITLE=MEDORA
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# === التخزين والنسخ الاحتياطي (اختياري — Forge/S3) ===
# FORGE_BASE_URL=
# FORGE_API_KEY=
# FORGE_BUCKET=

# === OAuth خارجي (اختياري) ===
# OAUTH_ISSUER_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
